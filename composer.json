{
    "name": "padeliz/padeliz-backend",
    "type": "application",
    "description": "Service API Laravel-based for https://padeliz.ro",
    "keywords": ["padel", "events", "padeliz", "api"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "darkaonline/l5-swagger": "^9.0",
        "google/apiclient": "^2.16",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "mpdf/mpdf": "^8.3",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "friendsofphp/php-cs-fixer": "^3.86",
        "larastan/larastan": "^3.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "format": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --verbose",
        "format:check": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "format:fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --verbose",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "test:lint": "php scripts/test-lint-no-generate.php",
        "setup:hooks": "chmod +x scripts/setup-git-hooks.sh && ./scripts/setup-git-hooks.sh"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "google/apiclient-services": [""]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
