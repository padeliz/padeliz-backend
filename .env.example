APP_NAME="Padeliz API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Bucharest

# logs
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# database
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db_padeliz
DB_USERNAME=db_user
DB_PASSWORD=db_pass

# cache (Redis / Valkey required — tagged invalidation)
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync # local: sync | staging/production: redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
MEMCACHED_HOST=127.0.0.1

# redis / DigitalOcean Valkey
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CLIENT=phpredis
REDIS_SCHEME=tcp # Staging/production Managed Valkey: REDIS_SCHEME=tls
REDIS_USERNAME=
REDIS_PASSWORD=null

# mail (local: mailhog | staging: log | production: Workspace SMTP relay)
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# base path for uploaded files
UPLOADS_BASE_PATH=public/uploads

# User uploads disk: local public | staging/production s3 (DigitalOcean Spaces)
USER_UPLOADS_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=fra1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=https://fra1.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# testing database
DB_TESTING_CONNECTION=mysql_testing
DB_TESTING_HOST=db
DB_TESTING_PORT=3306
DB_TESTING_DATABASE=db_padeliz_testing
DB_TESTING_USERNAME=db_user
DB_TESTING_PASSWORD=db_pass

# CORS — app + manager only (admin out of scope)
CORS_APP_ORIGIN=http://localhost:8081
CORS_MANAGER_ORIGIN=http://localhost:8083
CORS_ADMIN_ORIGIN=

# Google OAuth (Web Client IDs used to verify id_tokens; App and Manager must not share)
GOOGLE_APP_CLIENT_ID=
GOOGLE_MANAGER_CLIENT_ID=

# RankedIn BPT top-players integration (GET /api/external/bpt-rankedin/top-players)
RANKEDIN_BASE_URL=https://api.rankedin.com
RANKEDIN_BPT_ORGANISATION_ID=11317 # BPT organisation ID
RANKEDIN_BPT_RANKING_ID=15792 # BPT ranking ID
RANKEDIN_BPT_MEN_RANKING_TYPE=3 # BPT men ranking type
RANKEDIN_BPT_MEN_AGE_GROUP=82 # BPT men age group
RANKEDIN_BPT_WOMEN_RANKING_TYPE=4 # BPT women ranking type
RANKEDIN_BPT_WOMEN_AGE_GROUP=83 # BPT women age group
RANKEDIN_BPT_MAX_CONCURRENT_REQUESTS=6 # Maximum concurrent requests to RankedIn BPT API
RANKEDIN_BPT_HTTP_TIMEOUT=45 # HTTP timeout in seconds
RANKEDIN_BPT_ORG_EVENTS_PAGE_SIZE=50 # Page size for organisation events
RANKEDIN_BPT_RANKINGS_PAGE_SIZE=100 # Page size for rankings
RANKEDIN_BPT_DEFAULT_TAKE=20 # Default take for top-players
RANKEDIN_BPT_MAX_TAKE=100 # Maximum take for top-players

# Netopia Payments (sandbox locally/staging; live on production)
NETOPIA_POS_SIGNATURE=
NETOPIA_API_KEY=
NETOPIA_IS_LIVE=false
NETOPIA_RETURN_URL=http://localhost:8081
NETOPIA_NOTIFY_URL=
NETOPIA_PUBLIC_KEY_PATH=
