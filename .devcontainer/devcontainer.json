{
  "name": "Padeliz API (Laravel)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/padeliz-backend",
  "forwardPorts": [8000, 3306, 8080],
  "portsAttributes": {
    "8000": { "label": "Laravel App" },
    "3306": { "label": "MySQL" },
    "8080": { "label": "phpMyAdmin" }
  },
  "initializeCommand": [".devcontainer/scripts/sync-netopia-ipn-relay-profile"],
  "postCreateCommand": "bash -c 'git config --global core.autocrlf true && git config --global core.filemode false && git config --global --add safe.directory /workspaces/padeliz-backend && sudo chown -R www:www /workspaces/padeliz-backend && composer install && php artisan key:generate && php artisan migrate --seed && php artisan storage:link && composer setup:hooks || echo \"Setup completed with warnings\"'",
  "postStartCommand": "echo 'Waiting for services to be ready...' && sleep 10",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug",
        "junstyle.php-cs-fixer",
        "editorconfig.editorconfig",
        "ms-vscode.vscode-json",
        "redhat.vscode-yaml",
        "ms-vscode.vscode-markdown"
      ],
      "settings": {
        "editor.formatOnSave": false,
        "editor.formatOnPaste": false,
        "editor.formatOnType": false,
        "editor.defaultFormatter": "junstyle.php-cs-fixer",
        "editor.codeActionsOnSave": {
          "source.fixAll": "never",
          "source.organizeImports": "never"
        },
        "php.validate.enable": true,
        "php.suggest.basic": false,
        "php-cs-fixer.executablePath": "/workspaces/padeliz-backend/vendor/bin/php-cs-fixer",
        "php-cs-fixer.onsave": false,
        "php-cs-fixer.config": ".php-cs-fixer.php",
        "php-cs-fixer.autoExecutable": true,
        "php-cs-fixer.allowRisky": true,
        "php-cs-fixer.usingCache": true,
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "files.trimFinalNewlines": true,
        "[php]": {
          "editor.defaultFormatter": "junstyle.php-cs-fixer",
          "editor.tabSize": 4,
          "editor.insertSpaces": true,
          "editor.detectIndentation": false
        },
        "[json]": {
          "editor.tabSize": 2,
          "editor.insertSpaces": true
        },
        "[yaml]": {
          "editor.tabSize": 2,
          "editor.insertSpaces": true
        },
        "[markdown]": {
          "editor.tabSize": 2,
          "editor.insertSpaces": true
        }
      }
    }
  }
}
